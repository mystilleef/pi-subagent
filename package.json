{
  "name": "pi-subagent",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "verify": "bun check && bun test",
    "coverage": "bun check && bun test --coverage",
    "check": "biome check --error-on-warnings --fix --unsafe . && tsc --noEmit",
    "migrate": "biome migrate --write"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}

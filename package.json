{
  "name": "@mystilleef/pi-subagent",
  "version": "0.12.1",
  "description": "Pi subagent for the SPAE Framework",
  "author": "Lateef Alabi-Oki <mystilleef@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mystilleef/pi-subagent.git"
  },
  "bugs": {
    "url": "https://github.com/mystilleef/pi-subagent/issues"
  },
  "homepage": "https://github.com/mystilleef/pi-subagent#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "agent",
    "subagent",
    "orchestration",
    "ai",
    "llm"
  ],
  "module": "src/index.ts",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=18"
  },
  "files": [
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://raw.githubusercontent.com/mystilleef/pi-subagent/main/assets/parallel-agents-demo.mp4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write --unsafe --error-on-warnings .",
    "migrate": "biome migrate --write",
    "coverage": "bun test --parallel --parallel-delay=0",
    "check": "bun lint && bun typecheck",
    "verify": "bun migrate && bun check && bun coverage",
    "pack:smoke": "bun scripts/pack-smoke.ts",
    "release": "sh -c 'npm version \"$1\" -m \"chore(release): %s\" && git push --follow-tags' --"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typebox": "^1.3.11",
    "typescript": "^7.0.2"
  }
}

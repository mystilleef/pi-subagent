{
  "name": "@mystilleef/pi-subagent",
  "version": "0.1.0",
  "description": "Pi subagent for the SPAE Framework",
  "author": "Lateef Alabi-Oki <mystilleef@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mystilleef/pi-subagent.git"
  },
  "keywords": [
    "pi",
    "agent",
    "subagent",
    "orchestration",
    "ai",
    "llm"
  ],
  "module": "src/index.ts",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "files": [
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "verify": "bun check && bun test",
    "coverage": "bun check && bun test --coverage",
    "check": "biome check --fix --unsafe . && tsc --noEmit",
    "migrate": "biome migrate --write",
    "release": "npm version && git push --follow-tags && bun publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
